# DentalAi Environment Configuration Template
PROJECT_NAME="DentalAi"
VERSION="1.0.0"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://dental_user:dental_secret_pass@localhost:5432/dentalai_db?schema=public"
POSTGRES_USER="dental_user"
POSTGRES_PASSWORD="dental_secret_pass"
POSTGRES_DB="dentalai_db"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"

# GPU & Hardware Acceleration
USE_GPU=true
CUDA_VISIBLE_DEVICES=0

# Security & CORS Configuration
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
API_SECRET_KEY="change_this_to_a_secure_random_secret_in_production"
